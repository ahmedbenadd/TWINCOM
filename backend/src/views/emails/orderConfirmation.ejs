<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px; }
        .header { background-color: #4f46e5; color: white; padding: 20px; text-align: center; border-radius: 5px 5px 0 0; }
        .content { padding: 20px; }
        .footer { text-align: center; font-size: 12px; color: #777; margin-top: 20px; }
        .order-details { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .order-details th, .order-details td { border: 1px solid #eee; padding: 10px; text-align: left; }
        .total { font-weight: bold; text-align: right; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Order Confirmed!</h1>
        </div>
        <div class="content">
            <p>Hi <%= user.full_name || 'Customer' %>,</p>
            <p>Thank you for your order! We have received it and will start processing it right away.</p>
            
            <h3>Order #<%= order.id %></h3>
            <p><strong>Order ID:</strong> #ORD-<%= order.id.toString().padStart(6, '0') %></p>
            <p><strong>Payment Method:</strong> <%= order.payment_method %></p>
            
            <table class="order-details">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(function(item) { %>
                    <tr>
                        <td><%= item.name || item.product.name %></td>
                        <td><%= item.quantity || item.qty %></td>
                        <td>$<%= item.price %></td>
                    </tr>
                    <% }); %>
                    <tr>
                        <td colspan="2" class="total">Total:</td>
                        <td><strong>$<%= order.total_price %></strong></td>
                    </tr>
                </tbody>
            </table>

            <h3>Shipping Address</h3>
            <p>
                <%= order.address %><br>
                <%= order.city %>, <%= order.postal_code %><br>
                <%= order.country %>
            </p>
        </div>
        <div class="footer">
            <p>&copy; <%= year %> <%= appName %>. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
